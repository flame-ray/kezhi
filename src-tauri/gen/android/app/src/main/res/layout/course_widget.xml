<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="课织" android:textStyle="bold" android:textSize="17sp" android:textColor="@color/widget_text"/>
  <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="11sp" android:textColor="@color/widget_muted" android:text="今天"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="32dp" android:gravity="center" android:text="↻" android:textSize="25sp" android:textColor="@color/widget_accent" android:contentDescription="刷新桌面课表"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp" android:background="@drawable/widget_feature_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节课" android:textSize="11sp" android:textColor="@color/widget_accent"/>
  <TextView android:id="@+id/widget_next_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开课织，同步课程" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" android:textColor="@color/widget_text"/>
  <TextView android:id="@+id/widget_next_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今天与下一节课，一眼可见" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp" android:textColor="@color/widget_muted"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_today_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="今天的课程" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/widget_text"/>
 <TextView android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="3dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/widget_text" android:visibility="gone"/>
 <TextView android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="3dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/widget_text" android:visibility="gone"/>
 <TextView android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="3dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/widget_text" android:visibility="gone"/>
 <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end" android:text="点击打开课织" android:textSize="10sp" android:textColor="@color/widget_muted"/>
</LinearLayout>
