<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_day_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="今天" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" android:textColor="@color/widget_text"/>
    <TextView android:id="@+id/widget_day_refresh" android:layout_width="32dp" android:layout_height="32dp" android:text="↻" android:textSize="22sp" android:gravity="center" android:contentDescription="刷新今天课表" android:background="@drawable/widget_control_background" android:textColor="@color/widget_accent"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_day_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_muted" android:layout_marginTop="3dp"/>
  <TextView android:id="@+id/widget_day_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:layout_marginTop="5dp" android:layout_marginBottom="8dp"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:id="@+id/widget_day_rows" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"/>
    <ListView android:id="@+id/widget_day_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" android:visibility="gone"/>
    <TextView android:id="@+id/widget_day_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_muted" android:visibility="gone"/>
  </FrameLayout>
  <TextView android:id="@+id/widget_day_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:includeFontPadding="false" android:textColor="@color/widget_muted" android:layout_marginTop="6dp"/>
</LinearLayout>
