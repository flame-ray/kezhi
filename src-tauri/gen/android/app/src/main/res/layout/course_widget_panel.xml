<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="课织" android:textStyle="bold" android:textSize="15sp" android:includeFontPadding="false" android:textColor="@color/widget_text"/>
<TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:includeFontPadding="false" android:maxLines="1" android:textSize="11sp" android:textColor="@color/widget_muted" android:text="9月22日 周二"/>
<TextView android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/widget_control_background" android:text="↻" android:textSize="24sp" android:textColor="@color/widget_accent" android:contentDescription="刷新桌面课表"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginTop="8dp" android:background="@drawable/widget_feature_background">
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节课 · 今天" android:textSize="11sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
<TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:20" android:textSize="26sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginEnd="12dp"/>
<TextView android:id="@+id/widget_next_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="大学英语" android:textSize="17sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="1"/>
</LinearLayout>
<TextView android:id="@+id/widget_next_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="讲堂群 305 · 至 09:55" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/>
</LinearLayout>
<TextView android:id="@+id/widget_today_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今天 · 3 堂课" android:textSize="12sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="12dp"/>
<ViewFlipper android:id="@+id/widget_pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="156dp" android:layout_marginTop="6dp" android:autoStart="false" android:animateFirstView="false" android:inAnimation="@anim/widget_page_in" android:outAnimation="@anim/widget_page_out" android:visibility="gone"/>
<LinearLayout android:id="@+id/widget_pager" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:visibility="gone">
<TextView android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="23sp" android:textColor="@color/widget_accent" android:background="@drawable/widget_control_background" android:contentDescription="上一页课程"/>
<TextView android:id="@+id/widget_page_number" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="1 / 2" android:textSize="11sp" android:textColor="@color/widget_muted"/>
<TextView android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="23sp" android:textColor="@color/widget_accent" android:background="@drawable/widget_control_background" android:contentDescription="下一页课程"/>
</LinearLayout>
<TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击打开课表" android:textSize="10sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp"/>
</LinearLayout>
