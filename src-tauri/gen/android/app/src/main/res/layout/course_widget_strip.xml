<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="78dp" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节" android:textSize="10sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="08:20" android:textSize="25sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="4dp"/>
</LinearLayout>
<ImageView android:importantForAccessibility="no" android:layout_width="1dp" android:layout_height="32dp" android:background="@color/widget_outline" android:layout_marginEnd="12dp"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
<TextView android:id="@+id/widget_next_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="大学英语" android:textSize="15sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
<TextView android:id="@+id/widget_next_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="讲堂群 305 · 至 09:55" android:textSize="11sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp"/>
</LinearLayout></LinearLayout>
